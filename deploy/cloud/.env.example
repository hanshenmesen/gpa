GPA_CLOUD_SERVER_ENVIRONMENT=staging
GPA_CLOUD_SERVER_PUBLIC_ORIGIN=https://api.gpa.example
GPA_CLOUD_SERVER_SESSION_SIGNING_KEY=replace-with-at-least-32-random-characters
GPA_CLOUD_SERVER_IDENTITY_ISSUER=https://identity.example/
GPA_CLOUD_SERVER_IDENTITY_AUDIENCE=gpa-cloud-api
GPA_CLOUD_SERVER_IDENTITY_JWKS_URL=https://identity.example/.well-known/jwks.json
GPA_CLOUD_SERVER_OBJECT_STORAGE_ENDPOINT=https://objects.example
GPA_CLOUD_SERVER_OBJECT_STORAGE_BUCKET=gpa-replay-packages
GPA_CLOUD_SERVER_METRICS_TOKEN=replace-with-at-least-24-random-characters
GPA_CLOUD_SERVER_MAX_REQUEST_BYTES=1048576
GPA_CLOUD_SERVER_RATE_LIMIT_PER_MINUTE=300
GPA_CLOUD_SERVER_AUTH_RATE_LIMIT_PER_MINUTE=30
POSTGRES_PASSWORD=replace-with-a-long-random-password
