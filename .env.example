GPA_LLM_API_KEY=
GPA_LLM_BASE_URL=https://api.openai.com/v1
GPA_LLM_MODEL=gpt-5.5
# Optional: route text-only and screenshot requests to different models.
# GPA_LLM_TEXT_MODEL=gpt-5.4-mini
# GPA_LLM_VISION_MODEL=gpt-5.5
# Optional error fallback. The retry uses this model only after the primary
# request fails; successful requests never pay for both.
# GPA_LLM_TEXT_FALLBACK_MODEL=gpt-5.5
# GPA_LLM_VISION_FALLBACK_MODEL=gpt-5.4-mini
# Bound stalled provider requests and avoid multiplicative SDK retries. GPA's
# structured-output layer performs its own visible retry loop.
GPA_LLM_TIMEOUT_SECONDS=60
GPA_LLM_MAX_RETRIES=1

# Zhizengzeng OpenAI-compatible profile (keep the API key only in your local .env):
# GPA_LLM_BASE_URL=https://api.zhizengzeng.com/v1
# GPA_LLM_MODEL=qwen3.8-max
# GPA_LLM_TEXT_MODEL=qwen3.8-max
# GPA_LLM_VISION_MODEL=qwen3.7-plus
# GPA_LLM_TEXT_FALLBACK_MODEL=qwen3.7-plus
# GPA_LLM_VISION_FALLBACK_MODEL=qwen3.8-max

# Local data and model caches (relative paths are resolved from the repo root)
GPA_STORAGE_DIR=storage
# GPA_MODELS_CACHE_DIR=~/.cache/gpa/models
GPA_PORT=8765
# Optional for a remotely exposed community operations endpoint. When set,
# moderation writes require the same value in X-GPA-Operator-Token.
GPA_COMMUNITY_OPERATOR_TOKEN=

# Optional GPA cloud control plane. Leave the API URL empty for offline-only
# desktop use; production endpoints must use HTTPS/WSS.
GPA_CLOUD_ENV=development
GPA_CLOUD_API_URL=
GPA_CLOUD_WEB_URL=https://gpa-replay-online.hanshenmesenai.chatgpt.site
GPA_CLOUD_CONNECT_TIMEOUT_SECONDS=10
# GPA Cloud server values are required only on the hosted API process.
GPA_CLOUD_SERVER_IDENTITY_ISSUER=
GPA_CLOUD_SERVER_IDENTITY_AUDIENCE=
GPA_CLOUD_SERVER_IDENTITY_JWKS_URL=
GPA_CLOUD_SERVER_OBJECT_STORAGE_ENDPOINT=
GPA_CLOUD_SERVER_OBJECT_STORAGE_BUCKET=
# Desktop uses an available ephemeral loopback port by default.
GPA_DESKTOP_PORT=0
GPA_DESKTOP_DEBUG=0

# Optional runtime controls
GPA_ENABLE_DESKTOP_AUTOMATION=0
# macOS defaults to quartz. Do not use pynput there: its background keyboard
# translation path can terminate Python inside TextInputSources.
GPA_RECORDING_INPUT_BACKEND=quartz
# GPA never sends automated keyboard/paste actions into these apps by default.
# GPA_PROTECTED_INPUT_APPS=ChatGPT,Codex
# Only enable for a deliberately trusted workflow that targets those apps:
# GPA_ALLOW_PROTECTED_INPUT_APPS=0
GPA_PRELOAD_VISUAL_MODELS=0
GPA_REQUIRE_VISUAL_WARMUP=0
GPA_REPLAY_AGENT_FIRST=0
# Bounded safe recovery (wait/re-observe/dismiss blocking dialog) is on by default.
GPA_ENABLE_ERROR_RECOVERY=1
# Defaults to GPA_REPLAY_AGENT_FIRST when omitted.
# GPA_VERIFY_FINAL_STATE=1
GPA_MCP_ENABLE_EXECUTION=0
# GPA_UI_PARSE_CACHE_SIZE=16
